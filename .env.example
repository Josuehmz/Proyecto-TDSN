# Postgres + pgvector
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=rag_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://rag_admin:change_me_strong_password@postgres:5432/rag_platform

# Backend
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# JWT local del prototipo (en producción: OIDC)
JWT_SECRET=replace_me_with_a_long_random_string_min_32_chars
JWT_ALG=HS256
JWT_EXPIRE_MIN=60

# LLM obligatorio sin modo mock en producción: "openai" | "groq"
LLM_PROVIDER=groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Consumo LLM vía Groq (si LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Embeddings: "sentence-transformers" | "openai"
EMBEDDINGS_PROVIDER=sentence-transformers
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDINGS_DIM=384

RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Parámetros RAG
CHUNK_SIZE_TOKENS=384
CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
NO_ANSWER_THRESHOLD=0.15
FAITHFULNESS_THRESHOLD=0.7

# Seguridad
RATE_LIMIT_PER_MIN=120
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (Next.js)
# Opción A (Docker recomendada): proxy en Next; el cliente usa rutas relativas.
BACKEND_INTERNAL_URL=http://backend:8000
# Opción B: API en otro origen / dominio público (requiere CORS_ALLOWED_ORIGINS).
# NEXT_PUBLIC_API_URL=http://localhost:8000
